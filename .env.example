BOT_IMAGE=ghcr.io/streletskiy/ebk-tg-bot:latest
POSTGRES_DB=ebk_tg_bot
POSTGRES_USER=ebk_tg_bot
TELEGRAM_TOKEN=
EZBOOKKEEPING_URL=https://bookkeeping.example.com
# Use EZBOOKKEEPING_TOKEN_FILE in production; do not put tokens in Compose.
EZBOOKKEEPING_TOKEN_FILE=/data/ezbookkeeping.token
DATA_DIR=/data
CONTACTS_FILE=/data/contacts.json
CODEX_HOME=/data/codex
CODEX_BIN=codex
CODEX_MODEL=gpt-6.1-sol
CODEX_EFFORT=medium
CODEX_TIMEOUT=180
TIMEZONE=Europe/Moscow
DEFAULT_CURRENCY=RUB
DEFAULT_ACCOUNT_ID=
WHISPER_MODEL=small
WHISPER_LANGUAGE=ru
WHISPER_THREADS=4
MAX_MEDIA_MB=15
MAX_VOICE_SECONDS=180
MAX_QUERY_ROWS=10000
RETENTION_DAYS=30
LOG_LEVEL=INFO
# Optional per-bot egress proxy; ezBookkeeping stays direct.
MONEYBOT_HTTP_PROXY=
MONEYBOT_HTTPS_PROXY=
MONEYBOT_NO_PROXY=localhost,127.0.0.1,db,bookkeeping.example.com
